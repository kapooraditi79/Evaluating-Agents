            "type": "string"
          },
          "limit": {
            "description": "Maximum number of items to return",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "min_duration_ms": {
            "minimum": 0,
            "type": "number"
          },
          "operation": {
            "description": "Operation name, e.g. 'POST /checkout'",
            "type": "string"
          },
          "region": {
            "enum": [
              "us",
              "eu",
              "ap"
            ],
            "type": "string"
          },
          "service": {
            "description": "Service name, e.g. payment, checkout, frontend",
            "type": "string"
          },
          "start": {
            "description": "Window start (ISO-8601 UTC, e.g. 2026-03-14T14:05:00Z)",
            "type": "string"
          },
          "status": {
            "enum": [
              "OK",
              "ERROR"
            ],
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "type": "object"
      }
    },
    "type": "function"
  },
